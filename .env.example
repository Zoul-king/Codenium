# ============================================================================
# Base de datos 
# ============================================================================
DATABASE_URL=""
# Qué hace:     Cadena de conexión a la base de datos principal de la aplicación.
# Por qué existe:   La app la usa para conectarse, ejecutar consultas, migraciones y lectura/escritura de datos.
# Formato:      postgresql://usuario:contraseña@host:puerto/base_de_datos?schema=esquema
# Ejemplo:      postgresql://postgres:postgres@localhost:5432/codenium?schema=public 
# DB: postgresql  &  Nombre DB: codenium  &  Usuario: postgres  &  Contraseña: postgres  &  Puerto: 5432  &  Esquema: public
# Desarrollo:   Usualmente apunta a una base local o a un contenedor Docker.
# Producción:   Debe apuntar a una base administrada o servidor seguro, con credenciales reales, TLS si aplica, y sin exponer secretos en repositorio.

# ============================================================================
# Aplicación
# ============================================================================
APP_URL=""
# Qué hace:     URL pública base de la aplicación.
# Por qué existe:   Se usa para construir enlaces absolutos, redirecciones, callbacks e integraciones.
# Ejemplo en desarrollo:    http://localhost:3000
# Desarrollo:   Debe coincidir con la URL local donde corre la app.
# Producción:   Debe ser el dominio real, por ejemplo https://tudominio.com

SESSION_SECRET=""
# Qué hace:     Clave usada para firmar y validar sesiones o cookies seguras.
# Por qué existe:   Evita manipulación de sesiones y protege autenticación.
# Ejemplo:      replace-me-with-a-long-random-string
# Desarrollo:   Puede ser una cadena larga temporal, pero debe seguir siendo suficientemente aleatoria.
# Producción:   Debe ser una cadena larga, aleatoria, única y secreta. Nunca reutilizada entre proyectos.

NODE_ENV=""
# Qué hace:     Define el entorno de ejecución de Node.js.
# Por qué existe:   Muchas librerías cambian su comportamiento según development o production.
# Desarrollo:   development     &     Producción:   production

# ============================================================================
# Correo electrónico
# ============================================================================
EMAIL_PROVIDER=""
# Qué hace:     Define el proveedor de envío de correo.
# Por qué existe:   Permite desacoplar la lógica de correo del proveedor concreto.
# Ejemplo:  resend
# Desarrollo:   Puede seguir siendo resend si se están probando envíos reales.
# Producción:   Debe coincidir con el proveedor configurado en el sistema.

EMAIL_FROM=""
# Qué hace:     Remitente principal de los correos salientes.
# Por qué existe:   Es la identidad que verá el destinatario al recibir emails desde la app.
# Ejemplo:  Codenium <cotizaciones@codenium.nth-solutions.com.mx>
# Desarrollo:   Puede usarse si el dominio ya está validado.
# Producción:   Debe ser un remitente autorizado y alineado con SPF, DKIM y dominio verificado.

RESEND_FALLBACK_FROM=""
# Qué hace:     Remitente alterno para pruebas o fallback con Resend.
# Por qué existe:   Sirve cuando el dominio principal aún no está verificado o para testing controlado.
# Ejemplo:  Codenium <onboarding@resend.dev>
# Desarrollo:   Útil mientras se configura el dominio propio.
# Producción:   Idealmente no debería usarse como remitente principal.

CONTACT_EMAIL=""
# Qué hace:     Correo de contacto general del proyecto.
# Por qué existe:   Puede usarse para formularios, datos visibles al usuario o notificaciones internas.
# Ejemplo:  miguelAFP56@gmail.com
# Desarrollo:   Puede ser una cuenta de pruebas o del responsable.
# Producción:   Conviene usar un correo corporativo estable.

EMAIL_TO_CONTACT=""
# Qué hace:     Destinatario de mensajes enviados desde formularios de contacto.
# Por qué existe:   Centraliza a qué buzón llegan solicitudes de contacto.
# Ejemplo:  miguelAFP56@gmail.com
# Desarrollo:   Puede apuntar al correo del desarrollador para validar flujo.
# Producción:   Debe apuntar al buzón real del área responsable.

EMAIL_TO_QUOTES=""
# Qué hace:     Destinatario para solicitudes de cotización.
# Por qué existe:   Separa el flujo comercial del flujo de contacto general.
# Ejemplo:  miguelafp56@gmail.com
# Desarrollo:   Puede ser una cuenta personal o de pruebas.
# Producción:   Mejor un buzón comercial real, por ejemplo ventas@tuempresa.com

RESEND_API_KEY=""
# Qué hace:     API key para autenticar envíos con Resend.
# Por qué existe:   Sin esta clave la aplicación no puede enviar correos a través del proveedor.
# Ejemplo:  re_replace_me
# Desarrollo:   Puede usarse una clave de pruebas o de entorno de staging.
# Producción:   Debe ser una clave real, secreta, gestionada fuera del repositorio.

# ============================================================================
# IA / servicios externos
# ============================================================================
GROQ_API_KEY=""
# Qué hace:     API key para autenticar llamadas al servicio de Groq.
# Por qué existe:   Permite usar modelos o funcionalidades de IA desde la app.
# Ejemplo: (Cadena Alfanumérica)
# Desarrollo:
#       Puede dejarse vacío si la funcionalidad no se usa localmente.
# Producción:
#       Debe existir si la aplicación depende de Groq en tiempo de ejecución.

# ============================================================================
# Notas
# ============================================================================
# Este archivo .env.example sirve como plantilla para configurar variables de entorno locales y para entenderlas.
# El archivo .env.local se usará para desarrollo y se compartirá entre el equipo.  